#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&lt {
    tapping-term-ms = <300>;
};

/ {
    behaviors {
        encoder_vol: encoder_vol {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &lt 1 C_PP         // D0 - SPC position: tap = play/pause, hold = Bluetooth layer
                &kp ENTER          // D1 - ENT
                &kp RCMD           // D2 - VOX position (VoiceInk toggle)
                &kp C_MUTE         // D3 - encoder push (mute)
            >;

            sensor-bindings = <&encoder_vol>;
        };

        bluetooth_layer {
            display-name = "BT";
            bindings = <
                &trans             // (SPC itself, being held)
                &bt BT_SEL 1       // hold SPC + ENT = connect to computer 2
                &bt BT_SEL 0       // hold SPC + VOX = connect to computer 1
                &bt BT_CLR         // hold SPC + knob click = clear current profile's pairing
            >;

            sensor-bindings = <&encoder_vol>;
        };
    };
};
